{
  "name": "@farukada/aws-langchain-s3-vector-ts",
  "version": "0.7.0",
  "license": "MIT",
  "description": "LangChain-compatible Amazon S3 Vectors store for TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "author": "Faruk Ada <info@farukada.com>",
  "homepage": "https://github.com/FarukAda/aws-langchain-s3-vector-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FarukAda/aws-langchain-s3-vector-ts.git"
  },
  "bugs": {
    "url": "https://github.com/FarukAda/aws-langchain-s3-vector-ts/issues"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc6",
    "typecheck": "tsc6 --noEmit",
    "typecheck:types": "tsc6 --noEmit -p tsconfig.types.json",
    "test:package-smoke": "node --test test/package-smoke/smoke.test.mjs",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.cjs",
    "verify": "npm run build && node examples/verify-core.mjs && node examples/verify-search.mjs && node examples/verify-edge-cases.mjs",
    "verify:core": "npm run build && node examples/verify-core.mjs",
    "verify:search": "npm run build && node examples/verify-search.mjs",
    "verify:edge": "npm run build && node examples/verify-edge-cases.mjs",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "unused": "knip",
    "depcheck": "depcheck .",
    "cpd": "jscpd ./src --threshold 2 --min-lines 3 --reporters console --silent --format typescript,javascript",
    "cpd:full": "jscpd ./src --threshold 2 --min-lines 3 --reporters console-full --format typescript,javascript",
    "cpd:test": "jscpd ./test --threshold 2 --min-lines 3 --reporters console-full --format typescript,javascript"
  },
  "keywords": [
    "langchain",
    "vector-store",
    "aws",
    "s3-vectors",
    "embeddings",
    "rag",
    "similarity-search"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10.0.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3vectors": "^3.1117.0",
    "@langchain/core": "^1.2.9"
  },
  "devDependencies": {
    "@aws-sdk/client-s3vectors": "^3.1117.0",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@langchain/aws": "^1.4.4",
    "@langchain/core": "^1.2.9",
    "@smithy/types": "^4.17.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "aws-sdk-client-mock": "^4.1.0",
    "depcheck": "^1.4.7",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-instanceof": "^1.0.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "jest-sonar": "^0.2.16",
    "jiti": "^2.7.0",
    "jscpd": "^5.0.16",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.68.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "knip": {
    "ignore": [
      "jest.integration.config.cjs"
    ],
    "ignoreDependencies": [
      "@typescript/native"
    ]
  }
}
